DEMO_MODE=false
# Set true only after the host allows POK webhooks and signed provider media access.
PUBLIC_SERVICE_ACCESS=false
APP_ORIGIN=http://localhost:5173
APP_SECRET=
QUEUE_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
POK_KEY_ID=
POK_KEY_SECRET=
POK_MERCHANT_ID=
# staging (test payments, default) or production (real money)
POK_ENVIRONMENT=staging
# AI provider. Higgsfield runs the ready-made workflow; fal.ai and Replicate are optional for custom workflows.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
FAL_KEY=
REPLICATE_API_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
# Social sign-in (optional). Leave blank to offer only email sign-in. Can also be set in Admin → Connections.
# Google: OAuth client ID + secret. Redirect URI: <APP_ORIGIN>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID + Team ID + Key ID + the .p8 key contents. Return URL: <APP_ORIGIN>/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
